# Copy to .env (dev.cmd does this on first run). .env is git-ignored, so the
# key never leaves your laptop. The server reads it at startup; restart the
# API window after editing.

# Your Gemini API key (from Google AI Studio). Optional: without it, stages
# get names from a local list and everything else works the same.
GEMINI_API_KEY=

# The model to use. Not hardcoded anywhere: put your Gemini Pro model's name
# here. To see the exact names your key can use, run from backend/:
#   python -m tools.list_models
GEMINI_MODEL=

# Seconds to wait for Gemini before using a local name (Pro models are slower).
GEMINI_TIMEOUT_S=8

# Only needed if you save /debug calibration from a machine other than the
# one running the server.
DEBUG_TOKEN=
